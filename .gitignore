# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Claude Code internal files
AGENTS.md
CLAUDE.md
.claude/

# Android signing keystore -- real key material, never belongs in git no
# matter where it's generated (mobile/android/.gitignore already covers it
# scoped to that dir; this catches one dropped at the repo root instead).
release.keystore
*.jks
*.keystore

# dependencies
/frontend/node_modules
/frontend/.pnpm-store
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/frontend/coverage

# next.js
/frontend/.next/
/frontend/out/
# Static export for the native shell, and the copy Capacitor consumes. Both
# are build output -- mobile/www is regenerated by `npm run sync` in mobile/.
/frontend/out-mobile/
/mobile/www/

# production
/frontend/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.*.local
/frontend/.env
/frontend/.env.local
/frontend/.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
frontend/next-env.d.ts

# backend
/backend/server
/backend/walletgen
/backend/x402pay
/backend/*.env
/backend/.env
*.test

# test utilities (local dev only)
/test-x402/

# git worktrees
/.worktrees/

# root-level node_modules
/node_modules/

# Local dev scratch: planning notes and a static preview, intentionally untracked.
# Not referenced by the app or build. Delete a line to start tracking that file.
# connector/integration strategy notes
/CONNECTOR_STRATEGY.md
# planning doc for the credits/usage dashboard
/CREDITS_DASHBOARD_PLAN.md
# change log kept while iterating on the dashboard
/Dashboard_change.md
# standalone static mock of the usage page
/usage-preview.html
# root-level planning/scratch docs
/Docs/
# subagent-driven-development progress ledger (scratch, not part of the shipped project)
/.superpowers/
# subagent-driven-development plans/specs (scratch, not part of the shipped project)
/docs/superpowers/

# graphify knowledge-graph output (local cache + generated viz, not part of the shipped project)
/graphify-out/

# root-level plans folder: scratch planning docs, not part of shipped project
/plans/

# Local-only Docker overrides. Compose loads docker-compose.override.yml
# automatically with no opt-in, so a committed one silently reconfigures every
# other developer's `docker-compose up` -- in this repo's case onto Algorand
# mainnet with the real platform wallets, where each call spends real money.
docker-compose.override.yml
