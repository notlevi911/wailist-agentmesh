# ── Core ────────────────────────────────────────────────────────────────
# Supabase: use the TRANSACTION POOLER url (IPv4, port 6543). The direct
# db.<ref>.supabase.co host is IPv6-only and unreachable from Railway.
# URL-encode special chars in the password (@ -> %40).
DATABASE_URL=postgresql://postgres.<ref>:<url-encoded-password>@aws-1-<region>.pooler.supabase.com:6543/postgres
PORT=8080
# Public URL of THIS backend. Used for links a browser/JWT-cookie check
# needs directly (not OAuth callbacks — those go through FRONTEND_URL's
# /api proxy instead, see below).
BASE_URL=https://wailist-agentmesh-production-f943.up.railway.app
# Public URL of the frontend. OAuth redirects the browser back here after
# login, and OAuth callback URLs are built as FRONTEND_URL + /api/auth/oauth/
# <provider>/callback — Next.js rewrites /api/* to this backend (see
# frontend/next.config.ts) so the oauth_state_* cookie set at the start of
# the flow and the callback that reads it back are on the same origin. If
# this ever changes, the callback URLs below must be updated in the GitHub
# OAuth App and Google OAuth client too, or sign-in breaks with
# redirect_uri_mismatch / invalid_state.
FRONTEND_URL=https://www.agent-mesh.app

# ── Auth ────────────────────────────────────────────────────────────────
# 32+ bytes. Generate with: openssl rand -hex 32
JWT_SECRET=<openssl rand -hex 32>
# Allowed browser origin for CORS (the frontend).
CORS_ORIGIN=https://www.agent-mesh.app

# ── OAuth ───────────────────────────────────────────────────────────────
# GitHub OAuth App  (https://github.com/settings/developers)
#   Authorization callback URL:
#   https://www.agent-mesh.app/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth client  (https://console.cloud.google.com/apis/credentials)
#   Authorized redirect URI:
#   https://www.agent-mesh.app/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Connector account-linking OAuth (issue #32) ─────────────────────────
# Separate app registrations from the login flow above — per-connector API
# scopes, not read:user user:email, and tokens are stored per-workflow-node
# rather than per-user-login.
# Redirect/callback URL for every provider below follows the same shape —
# the FRONTEND_URL origin (not BASE_URL), so the auth cookie set on the
# frontend domain is forwarded by the browser via next.config.ts's /api
# rewrite:
#   https://wailist-agentmesh-zeta.vercel.app/api/connectors/oauth/<provider>/callback
# Slack app  (https://api.slack.com/apps)
#   Redirect URL: https://wailist-agentmesh-zeta.vercel.app/api/connectors/oauth/slack/callback
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
# GitHub OAuth App, separate registration from GITHUB_CLIENT_ID above
#   (https://github.com/settings/developers)
#   Authorization callback URL:
#   https://wailist-agentmesh-zeta.vercel.app/api/connectors/oauth/github/callback
GITHUB_CONNECTOR_CLIENT_ID=
GITHUB_CONNECTOR_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
MAILCHIMP_CLIENT_ID=
MAILCHIMP_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=

# ── Encryption (agent wallet mnemonics) ─────────────────────────────────
# 32 hex bytes.
ENCRYPTION_KEY=00000000000000000000000000000000

# ── Algorand ────────────────────────────────────────────────────────────
ALGOD_URL=https://testnet-api.algonode.cloud
ALGOD_TOKEN=
ALGORAND_NETWORK=testnet

# ── Platform-key LLM mode ──────────────────────────────────────────────
# AgentMesh's own provider credentials, used only by Provider nodes with
# keyMode="platform" (issue #25). Optional per-provider — leave any blank
# to disable platform-key mode for that provider; BYOK nodes are unaffected.
# Never returned to any client response.
PLATFORM_GEMINI_API_KEY=
PLATFORM_OPENAI_API_KEY=
PLATFORM_ANTHROPIC_API_KEY=
PLATFORM_GROQ_API_KEY=
PLATFORM_MISTRAL_API_KEY=

# ── Payments (Cashfree) ─────────────────────────────────────────────────
# From dashboard.cashfree.com → Developers → API Keys
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# From Cashfree dashboard → Developers → Webhooks → Secret Key
CASHFREE_WEBHOOK_SECRET=
# Set to "true" to point at the sandbox API (use with sandbox credentials)
CASHFREE_SANDBOX=false

# ── Payments (NOWPayments — crypto top-ups) ─────────────────────────────
# From https://account.nowpayments.io/settings (or https://account-sandbox.nowpayments.io/
# for a sandbox_-prefixed test key — see NOWPAYMENTS_SANDBOX below).
NOWPAYMENTS_API_KEY=
# Store settings > IPN Secret in the same dashboard. Verifies the x-nowpayments-sig header
# on /payments/nowpayments/webhook — distinct from the API key above.
NOWPAYMENTS_IPN_SECRET=
# "true" points the client at api-sandbox.nowpayments.io instead of the live API — use with
# a sandbox_-prefixed API key and its own IPN secret while testing this integration.
NOWPAYMENTS_SANDBOX=false

# ── Coupons (optional) ───────────────────────────────────────────────────
# Redeemable coupon codes, as a comma-separated list of CODE:AMOUNT pairs with
# AMOUNT in US dollars (the credits the code grants). Codes are matched
# case-insensitively. Each code is redeemable once per user; distinct codes
# stack. Leave unset/blank to disable coupon redemption entirely — a code only
# works while it's listed here, so retiring a campaign is a config change, not a
# deploy. A malformed entry stops the server at startup rather than half-loading
# the catalog.
#   COUPON_CODES=WELCOME5:5,LAUNCH:12.50
COUPON_CODES=

# ── Discord audit log (optional) ─────────────────────────────────────────
# Discord incoming webhook URLs (Channel Settings > Integrations > Webhooks > New
# Webhook > Copy Webhook URL). Each is independent — leave any blank to disable that
# channel. Alerting is best-effort and never blocks the payment/workflow path it reports on.
# Payment failures: rejected webhook signatures, FX outages, internal errors
# completing/refunding a transaction.
DISCORD_WEBHOOK_PAYMENTS_URL=
# Every successful credit and refund — the money audit trail.
DISCORD_WEBHOOK_CREDITS_URL=
# Every workflow run: started, finished (success/failed/stopped).
DISCORD_WEBHOOK_WORKFLOWS_URL=
